{
  "name": "brclio-pay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-docs.mjs",
    "dev": "wrangler dev --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prebuild": "node scripts/sync-docs.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "predeploy": "node scripts/sync-docs.mjs",
    "deploy": "wrangler deploy",
    "build:pages": "node scripts/build-pages.mjs",
    "deploy:pages": "npm run build:pages && wrangler pages deploy --cwd cloudflare/pages --project-name brclio-pay --branch main --commit-dirty=true",
    "test:runtime": "node scripts/runtime-check.mjs",
    "client": "node examples/client.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "alipay-sdk": "4.14.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4",
    "wrangler": "latest"
  },
  "overrides": {
    "urllib": "4.9.1"
  }
}
